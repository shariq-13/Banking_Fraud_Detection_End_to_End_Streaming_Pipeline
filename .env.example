# Copy this file to .env and fill in your values. Never commit .env.

# AWS
AWS_REGION=ap-south-1
S3_BUCKET=replace-with-your-unique-bucket-name

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=banking.transactions
KAFKA_TOPIC_INVALID=banking.invalid-transactions
KAFKA_GROUP_ID=fraud-detection-consumer

# Snowflake (use the account identifier shown in Snowsight, e.g. orgname-accountname)
SNOWFLAKE_ACCOUNT=replace-with-your-account-identifier
SNOWFLAKE_USER=FRAUD_APP
SNOWFLAKE_PASSWORD=replace-with-your-password
SNOWFLAKE_ROLE=FRAUD_ROLE
SNOWFLAKE_WAREHOUSE=FRAUD_WH
SNOWFLAKE_DATABASE=BANKING_FRAUD
SNOWFLAKE_SCHEMA=RAW

# dbt writes models to this schema
DBT_SCHEMA=ANALYTICS
